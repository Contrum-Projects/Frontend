# Copia este archivo a .env.local (nunca subas .env.local al repositorio: RNF-10).
# El frontend no guarda secretos: todo lo que aparece aquí es público o una URL.

# URL del backend, sin /api. Solo la lee el servidor de Next (proxy /api y Server Components).
API_URL=http://localhost:3000

# Dominio público de las imágenes del catálogo (R2_URL_PUBLICA del backend). Se usa al compilar.
# Vacío: next/image no optimiza imágenes externas.
URL_IMAGENES=

# URL pública de la tienda, para metadatos y enlaces absolutos (Open Graph). Se usa al compilar.
NEXT_PUBLIC_URL_SITIO=http://localhost:3001
